#!/bin/bash
# Atura el commit si s'hi cola un fitxer de secrets o un text que sembli una clau.
# S'activa amb: git config core.hooksPath .githooks (ho fa .claude/hooks/session-start.sh)
set -euo pipefail

blocked=0

# 1) Fitxers que no han d'anar mai al repositori.
while IFS= read -r file; do
  case "$file" in
    .env.example) ;;
    .env | .env.* | */.env | */.env.* | *.pem | *.key | *.p12 | \
    google-services.json | */google-services.json | \
    GoogleService-Info.plist | */GoogleService-Info.plist | \
    serviceAccount*.json | */serviceAccount*.json)
      echo "✋ No es pot pujar «${file}»: és un fitxer de secrets." >&2
      blocked=1
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2) Línies afegides que semblen claus (Google/Firebase, AWS, GitHub, Anthropic, claus privades).
pattern='AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|gh[pousr]_[0-9A-Za-z]{36}|sk-ant-[0-9A-Za-z_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
if git diff --cached -U0 --diff-filter=ACMR -- . ':(exclude).githooks/pre-commit' \
  | grep -E '^\+' | grep -qE "$pattern"; then
  echo "✋ Hi ha una línia que sembla una clau o un secret. Treu-la del commit." >&2
  blocked=1
fi

if [ "$blocked" -ne 0 ]; then
  echo "   Si és un fals positiu i n'estàs segura: git commit --no-verify" >&2
  exit 1
fi
